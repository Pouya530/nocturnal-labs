{
  "name": "nocturnal-labs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-dev.mjs",
    "dev:clean": "node -e \"const fs=require('fs');for(const d of ['.next','.next-dev']){try{fs.rmSync(d,{recursive:true,force:true});}catch(e){if(e&&e.code!=='ENOENT')throw e;}}\"",
    "dev:fresh": "npm run dev:clean && node scripts/next-dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "gen:wp-coin": "node scripts/gen-wp-coin-embed.mjs",
    "gen:wp-coin-url": "node scripts/gen-wp-coin-embed-url.mjs"
  },
  "dependencies": {
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "detect-gpu": "^5.0.70",
    "next": "^14.2.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/three": "0.170.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.28",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a"
}
